<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!--Podgląd kamery-->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--Celownik -->
    <com.example.przestrzeliny_app.CrosshairView
        android:id="@+id/crosshairView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.7"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--Wyniki AI -->
    <TextView
        android:id="@+id/txtResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:background="#80000000"
        android:padding="10dp"
        android:text="Czekam na strzał..."
        android:textColor="#00FF00"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--Główny przycisk "Zrób zdjęcie"-->
    <ImageButton
        android:id="@+id/btnCapture"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/circle_btn"
        android:elevation="4dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!--Przycisk "Wybierz z Galerii" -->
    <Button
        android:id="@+id/btnGallery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:backgroundTint="#444444"
        android:text="GALERIA"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/btnCapture"
        app:layout_constraintEnd_toStartOf="@id/btnCapture"
        app:layout_constraintTop_toTopOf="@id/btnCapture" />

    <!--Przycisk "Zmień kamerę" -->
    <Button
        android:id="@+id/btnSwitchCamera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:backgroundTint="#444444"
        android:text="OBRÓĆ"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/btnCapture"
        app:layout_constraintStart_toEndOf="@id/btnCapture"
        app:layout_constraintTop_toTopOf="@id/btnCapture" />

    <View
        android:id="@+id/targetFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/target_frame_border"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintDimensionRatio="1:1" />

    <ImageView
        android:id="@+id/imageViewResult"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FF000000"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Panel Sterowania (Zoom, Obiektywy, Kontrast, Jasność) -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:background="#80000000"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/btnCapture"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Nagłówek Zoom + Szybki wybór obiektywu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Zoom"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <!-- Przyciski szybkich obiektywów -->
            <Button
                android:id="@+id/btnZoom05"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#444444"
                android:padding="0dp"
                android:text="0.5x"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnZoom1"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#444444"
                android:padding="0dp"
                android:text="1x"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnZoom2"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:backgroundTint="#444444"
                android:padding="0dp"
                android:text="2x"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/zoomSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <!-- Przełącznik Korekcji Obrazu -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchEnhance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="Korekcja kontrastu i jasności"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <!-- Suwaki Kontrastu i Jasności -->
        <LinearLayout
            android:id="@+id/enhanceSlidersLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Kontrast -->
            <TextView
                android:id="@+id/txtContrast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kontrast: 1.5x"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/contrastSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="20"
                android:progress="10" />

            <!-- Jasność -->
            <TextView
                android:id="@+id/txtBrightness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jasność: 0"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/brightnessSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
